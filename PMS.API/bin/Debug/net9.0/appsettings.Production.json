{
  "Database": {
    "Provider": "${DATABASE_PROVIDER:SqlServer}"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=${DB_HOST};Database=${DB_NAME};User Id=${DB_USER};Password=${DB_PASSWORD};Port=${DB_PORT};SslMode=Require;TrustServerCertificate=true;"
  },
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "PMS.API",
    "Audience": "PMS.Users",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "EmailSettings": {
    "SmtpServer": "${SMTP_SERVER}",
    "SenderEmail": "${SENDER_EMAIL}",
    "SenderName": "${SENDER_NAME}",
    "Username": "${SMTP_USERNAME}",
    "Password": "${SMTP_PASSWORD}",
    "UseSsl": true,
    "RequireAuthentication": true,
    "TetfundLogoUrl": "https://tetfund.gov.ng/images/logo.png",
    "SupportUrl": "https://tetfund.gov.ng/support",
    "HelpUrl": "https://tetfund.gov.ng/help",
    "PrivacyUrl": "https://tetfund.gov.ng/privacy"
  },
  "AppSettings": {
    "BaseUrl": "${BASE_URL}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
